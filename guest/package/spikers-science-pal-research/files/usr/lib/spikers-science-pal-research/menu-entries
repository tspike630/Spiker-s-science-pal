#!/usr/bin/python3 -I
"""Keep the 科研 column in the user's Omarchy menu.

Same shape as Install → AI: one parent row with no action, then one child
per field. The rows go into ~/.config/omarchy/extensions/omarchy-menu.jsonc.
A marker in ~/.local/state/spikers-science-pal-research records which release
was added, so a row the user deletes stays deleted. A row whose text is still
exactly what this wrote last time is rewritten; a row the user edited stays.
Rows from the previous flat list (workbench.* and judges.*) are removed when
they are still exactly what this wrote.
"""

import json
import os
from pathlib import Path
import re
import sys
import tempfile

import fields

MAXIMUM_BYTES = 256 * 1024
HEADER = "  // Spiker's Science Pal research: 科研 column, one app per field (added once each; safe to remove).\n"
OLD_HEADER = "  // Spiker's Science Pal research: workbench and 15-judge guide rows (added once each; safe to remove).\n"
RELEASE = 2


def own(entry):
    return lambda spikers: entry


def judge_rows():
    """One app row per field, plus the capability-matrix page."""
    data_path = Path(os.environ.get("SPIKERS_SCIENCE_PAL_JUDGES_DATA")
                     or "/usr/share/spikers-science-pal-research/judges.json")
    try:
        data = json.loads(data_path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return []
    overview = data.get("overview") or {}
    rows = [("research.overview", RELEASE, own({
        "icon": fields.DEFAULT_ICON,
        "label": "功能矩阵",
        "description": overview.get("menu_label") or "15 个领域的说明页",
        "action": "spikers-science-pal-domain overview"}))]
    for judge in data["judges"]:
        rows.append((f"research.{judge['id']}", RELEASE, own({
            "icon": fields.icon(judge["id"]),
            "label": fields.label(judge),
            "description": f"{judge['name_zh']} · {judge.get('research', '')}",
            "action": f"spikers-science-pal-research-app {judge['id']}"})))
    return rows


def column_rows():
    parent = ("research", RELEASE, own({
        "icon": fields.DEFAULT_ICON, "label": "科研", "title": "科研"}))
    utilities = (
        ("research.note", RELEASE, own({
            "icon": "\U000f0237", "label": "新建实验记录",
            "description": "在 ~/science/notes 写一篇带日期的笔记",
            "action": "omarchy-launch-floating-terminal-with-presentation /usr/bin/spikers-science-pal-new-note"})),
        ("research.literature", RELEASE, own({
            "icon": "\U000f0881", "label": "文献库",
            "description": "Zotero",
            "when": "command -v zotero", "action": "zotero"})),
        ("research.jupyter", RELEASE, own({
            "icon": "\U000f16be", "label": "Jupyter Lab",
            "when": "command -v jupyter",
            "action": "omarchy-launch-floating-terminal-with-presentation jupyter lab"})),
        ("research.directory", RELEASE, own({
            "icon": "\U000f00af", "label": "工作台目录",
            "description": "打开 ~/science", "action": 'xdg-open "$HOME/science"'})),
        ("research.exports", RELEASE, own({
            "icon": "\U000f0079", "label": "作品导出",
            "description": "打开 ~/science/exports", "action": 'xdg-open "$HOME/science/exports"'})),
    )
    return (parent,) + tuple(judge_rows()) + utilities


def parse_jsonc(text):
    text = re.sub(r"^\s*//[^\n]*(\n|$)", "", text, flags=re.M)
    return json.loads(re.sub(r",(\s*[}\]])", r"\1", text))


def spikers_rows():
    path = Path(os.environ.get("SPIKERS_SCIENCE_PAL_SPIKERS_MENU")
                or Path(os.environ.get("OMARCHY_PATH") or "/usr/share/omarchy") / "default/omarchy/omarchy-menu.jsonc")
    try:
        rows = parse_jsonc(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return rows if isinstance(rows, dict) else {}


def render(key, entry):
    return f'  "{key}": {json.dumps(entry, ensure_ascii=False, separators=(",", ":"))},\n'


def added_release(state):
    marker = state / "spikers-science-pal-research/menu-entries"
    if marker.is_file():
        try:
            return int(marker.read_text().strip())
        except ValueError:
            return RELEASE
    return 0


def write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
    with os.fdopen(descriptor, "w") as output:
        output.write(text)
    os.chmod(temporary, 0o644)
    os.replace(temporary, path)


def retire_stale(text, written, live):
    """Drop rows we wrote for the old flat list, when the user has not edited them."""
    for key, previous in list(written.items()):
        if key in live:
            continue
        line = re.search(rf'^  "{re.escape(key)}":[^\n]*\n', text, re.M)
        if line is None:
            written.pop(key, None)
            continue
        if line.group(0) == previous:
            text = text.replace(previous, "", 1)
            written.pop(key, None)
    return text


def main():
    home = Path(os.environ["HOME"])
    config = Path(os.environ.get("XDG_CONFIG_HOME") or home / ".config")
    state = Path(os.environ.get("XDG_STATE_HOME") or home / ".local/state")
    path = config / "omarchy/extensions/omarchy-menu.jsonc"
    written_path = state / "spikers-science-pal-research/menu-rows.json"
    if path.is_symlink():
        return 0

    if path.exists():
        if path.stat().st_size > MAXIMUM_BYTES:
            return 0
        text = path.read_text(encoding="utf-8")
        opening = text.find("{")
        if opening < 0 or text[:opening].strip() or text.rstrip()[-1:] != "}":
            return 0
    else:
        text = "{\n}\n"
        opening = 0
    original = text
    try:
        written = json.loads(written_path.read_text(encoding="utf-8"))
        if not isinstance(written, dict):
            written = {}
    except (OSError, ValueError):
        written = {}

    rows = column_rows()
    live = {key for key, _release, _build in rows}
    text = retire_stale(text, written, live)

    done = added_release(state)
    spikers = spikers_rows()
    new_rows = ""
    for key, release, build in rows:
        entry = build(spikers)
        row = render(key, entry) if entry else None
        line = re.search(rf'^  "{re.escape(key)}":[^\n]*\n', text, re.M)
        if line or f'"{key}"' in text:
            current = line.group(0) if line else None
            if row and current and current != row and current == written.get(key):
                text = text.replace(current, row, 1)
                written[key] = row
            elif row and current == row:
                written[key] = row
            continue
        if release > done and row:
            new_rows += row
            written[key] = row

    if new_rows:
        if HEADER not in text:
            new_rows = HEADER + new_rows
        opening = text.find("{")
        text = text[: opening + 1] + "\n" + new_rows + text[opening + 1:].lstrip("\n")
    if OLD_HEADER in text and HEADER in text:
        text = text.replace(OLD_HEADER, "", 1)
    elif OLD_HEADER in text:
        text = text.replace(OLD_HEADER, HEADER, 1)
    if text != original:
        write(path, text)
    write(written_path, json.dumps(written, ensure_ascii=False, indent=1) + "\n")
    marker = state / "spikers-science-pal-research/menu-entries"
    marker.parent.mkdir(parents=True, exist_ok=True)
    marker.write_text(f"{RELEASE}\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
