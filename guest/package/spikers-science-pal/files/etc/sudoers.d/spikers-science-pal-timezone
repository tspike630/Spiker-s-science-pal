# Like Spiker's Science Pal's omarchy-tzupdate rule for timedatectl set-timezone: the
# desktop's time zone picker fixes a zone, or follows the Mac, without a password.
%wheel ALL=(root) NOPASSWD: /usr/bin/spikers-science-pal-timezone --follow-mac
%wheel ALL=(root) NOPASSWD: /usr/bin/spikers-science-pal-timezone ^--select [A-Za-z0-9_+][A-Za-z0-9_+.-]*(/[A-Za-z0-9_+][A-Za-z0-9_+.-]*)*$
