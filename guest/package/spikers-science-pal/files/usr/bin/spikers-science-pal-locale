#!/bin/sh

# Seed LANG from the Mac while Spiker's Science Pal's owner provisioning is pending: on a
# fresh factory's first boot, or after Spiker's Science Pal's own factory reset. Once an
# owner exists, language choices made inside Spiker's Science Pal are left alone.

set -eu

cmdline_path=${SPIKERS_SCIENCE_PAL_LOCALE_CMDLINE_PATH:-/run/spikers-science-pal/cmdline}
locale_conf=${SPIKERS_SCIENCE_PAL_LOCALE_CONF_PATH:-/etc/locale.conf}
pending=${SPIKERS_SCIENCE_PAL_LOCALE_PENDING_PATH:-/var/lib/omarchy/provisioning/pending}
[ -f "$pending" ] || exit 0

# Refuse to write through a symlink (dangling or not). This runs as root on
# every boot, and locale_conf's target would otherwise be unchecked.
[ ! -L "$locale_conf" ] || exit 1

command_line=""
IFS= read -r command_line <"$cmdline_path" || exit 1

# Unsupported or absent host language uses the factory default.
locale=en_US.UTF-8
set -f
for argument in $command_line; do
  case $argument in
    spikerssciencepal.locale=*)
      candidate=${argument#spikerssciencepal.locale=}
      # Allowlist: the languages Spiker's Science Pal seeds. The host settings are
      # attacker-influenced in principle and this value is about to be written into a file PAM
      # reads on every login, so anything else is ignored (keeping whatever
      # is already selected) rather than trusted or shell-interpolated.
      case $candidate in
        en_US.UTF-8 | zh_TW.UTF-8 | zh_CN.UTF-8 | ko_KR.UTF-8 | ja_JP.UTF-8) locale=$candidate ;;
      esac
      ;;
  esac
done

# A stock install generates en_US only. Generate the Mac's language first, so
# LANG never names a locale the system cannot load.
locale_gen=${SPIKERS_SCIENCE_PAL_LOCALE_GEN_PATH:-/etc/locale.gen}
if [ "$locale" != en_US.UTF-8 ] && [ -z "${SPIKERS_SCIENCE_PAL_LOCALE_SKIP_GENERATE:-}" ]; then
  if ! grep -q "^$locale UTF-8" "$locale_gen"; then
    sed -i "s/^#$locale UTF-8/$locale UTF-8/" "$locale_gen"
    grep -q "^$locale UTF-8" "$locale_gen" || printf '%s UTF-8\n' "$locale" >>"$locale_gen"
  fi
  locale-gen >/dev/null
fi

# Replace LANG only: users can customize LC_TIME, LC_NUMERIC and other
# categories after provisioning. Never source their configuration as root.
python3 - "$locale_conf" "$locale" <<'PY'
import os
from pathlib import Path
import re
import stat
import sys
import tempfile

path = Path(sys.argv[1])
try:
    mode = path.lstat().st_mode
except FileNotFoundError:
    mode = stat.S_IFREG | 0o644
if not stat.S_ISREG(mode):
    raise SystemExit("locale.conf must be a regular file")
contents = path.read_text() if path.exists() else ""
lines = [line for line in contents.splitlines(keepends=True)
         if not re.match(r"^[ \t]*(?:export[ \t]+)?LANG[ \t]*=", line)]
preserved = "".join(lines)
if preserved and not preserved.endswith("\n"):
    preserved += "\n"
updated = preserved + f"LANG={sys.argv[2]}\n"
if contents != updated:
    descriptor, temporary = tempfile.mkstemp(prefix=".locale.conf.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w") as output:
            output.write(updated)
            output.flush()
            os.fchmod(output.fileno(), stat.S_IMODE(mode))
            os.fsync(output.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
PY
