#!/bin/bash
#
# Touch ID unlock for 1Password in this guest (opt-in). Enables the root agent
# spikers-science-pal-onepassword-touch-id@USER.service, which answers 1Password's
# "Unlock using system authentication" requests with Touch ID on the Mac.
# See docs/onepassword-touch-id.md.
#
#   spikers-science-pal-onepassword-touch-id [manage|enable|disable|status [--quiet]]

set -euo pipefail

user=${SPIKERS_SCIENCE_PAL_ONEPASSWORD_USER:-$(id -un)}
unit="spikers-science-pal-onepassword-touch-id@$user.service"
pairing=/var/lib/spikers-science-pal/native-authentication.json
onepassword=/opt/1Password/1password

enabled() {
  systemctl is-enabled --quiet "$unit" 2>/dev/null
}

confirm() {
  gum confirm "$1"
}

refresh_menu() {
  spikers menu refresh >/dev/null 2>&1 || true
}

enable_unlock() {
  if enabled; then
    echo "Touch ID unlock is already enabled for 1Password."
    return
  fi
  [[ -x $onepassword ]] || {
    echo "Install 1Password first (Spiker's Science Pal menu: Install > Service > 1Password)." >&2
    exit 1
  }
  [[ -f $pairing ]] || {
    echo "Pair Touch ID first: enable Touch ID for sudo in the Spiker's Science Pal menu (Setup > Security)." >&2
    exit 1
  }
  printf '%s\n' \
    "In 1Password, turn on Settings > Security > Unlock using system authentication," \
    "then lock and unlock once with your account password." \
    "" \
    "Touch ID approves the unlock only while this Spiker's Science Pal window is focused." \
    "Your guest password stays available as fallback."
  confirm "Enable Touch ID unlock for 1Password?" || exit 130
  sudo systemctl enable --now "$unit"
  refresh_menu
  echo "Touch ID unlock is enabled for 1Password."
}

disable_unlock() {
  if ! enabled; then
    echo "Touch ID unlock is already disabled for 1Password."
    return
  fi
  confirm "Disable Touch ID unlock for 1Password?" || exit 130
  sudo systemctl disable --now "$unit"
  refresh_menu
}

case "${1:-manage}" in
  manage)
    if enabled; then disable_unlock; else enable_unlock; fi
    ;;
  enable)
    enable_unlock
    ;;
  disable)
    disable_unlock
    ;;
  status)
    if enabled; then
      [[ ${2:-} == --quiet ]] || echo "enabled"
      exit 0
    fi
    [[ ${2:-} == --quiet ]] || echo "disabled"
    exit 1
    ;;
  *)
    echo "Usage: spikers-science-pal-onepassword-touch-id [manage|enable|disable|status [--quiet]]" >&2
    exit 64
    ;;
esac
