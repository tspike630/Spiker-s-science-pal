#!/bin/bash
# Start sshd for this boot only when the launcher forwards SSH
# (spikerssciencepal.ssh_access=1), and open Spiker's Science Pal's firewall for it: from the NAT
# gateway QEMU forwards through (10.0.2.2), or from anywhere when the VM is
# bridged onto the network (spikerssciencepal.ssh_from=any). Without the token the
# rules are removed again; sshd is never enabled persistently.
set -euo pipefail

systemctl=${SPIKERS_SCIENCE_PAL_SYSTEMCTL:-systemctl}
ufw=${SPIKERS_SCIENCE_PAL_UFW:-ufw}
enabled=0 from=10.0.2.2
read -r -a options <"${SPIKERS_SCIENCE_PAL_HOST_CMDLINE:-/run/spikers-science-pal/cmdline}" || true
for option in ${options[@]+"${options[@]}"}; do
  case $option in
    spikerssciencepal.ssh_access=1) enabled=1 ;;
    spikerssciencepal.ssh_from=any) from=any ;;
  esac
done

nat_rule=(proto tcp from 10.0.2.2 to any port 22)
any_rule=(proto tcp from any to any port 22)
if command -v "$ufw" >/dev/null; then
  "$ufw" delete allow in "${nat_rule[@]}" >/dev/null 2>&1 || true
  "$ufw" delete allow in "${any_rule[@]}" >/dev/null 2>&1 || true
  if ((enabled)); then
    if [[ $from == any ]]; then
      "$ufw" allow in "${any_rule[@]}" comment spikers-science-pal-ssh >/dev/null
    else
      "$ufw" allow in "${nat_rule[@]}" comment spikers-science-pal-ssh >/dev/null
    fi
  fi
fi
((enabled)) || exit 0
exec $systemctl start --no-block sshd.service
