[Unit]
Description=Mount the Mac folder shared by Spiker's Science Pal
After=local-fs.target systemd-modules-load.service
Before=sddm.service display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/spikers-native-mac-share --mount
ExecStop=/usr/bin/spikers-native-mac-share --unmount

[Install]
WantedBy=multi-user.target
