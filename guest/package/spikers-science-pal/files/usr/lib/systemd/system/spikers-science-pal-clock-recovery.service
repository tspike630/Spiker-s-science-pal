[Unit]
Description=Recover Spiker's Science Pal guest time after host sleep
ConditionPathExists=/run/spikers-science-pal/cmdline
ConditionPathExists=/sys/class/rtc/rtc0/since_epoch
After=systemd-timesyncd.service

[Service]
Type=oneshot
ExecStart=/usr/lib/spikers-science-pal/guest-clock-recover
TimeoutStartSec=10
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_TIME
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
