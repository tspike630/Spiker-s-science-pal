[Unit]
Description=Read the Spiker's Science Pal launcher settings for this boot
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ImportCredential=spikerssciencepal.host
ExecStart=/usr/lib/spikers-science-pal/host-config

[Install]
WantedBy=sysinit.target
