[Unit]
Description=Expose the macOS camera to Spiker's Science Pal over virtio
PartOf=graphical-session.target
After=graphical-session.target
# The camera devices are granted to the active session by logind (uaccess),
# which can land after the user manager starts this unit: keep retrying.
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/spikers-native-camera-bridge
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
