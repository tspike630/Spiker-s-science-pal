[Unit]
Description=Share the macOS clipboard with Spiker's Science Pal
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathExists=/dev/virtio-ports/dev.spikerssciencepal.clipboard
# The agent exits non-zero whenever the host bridge disconnects; keep
# retrying for as long as the launcher keeps restarting that bridge.
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/spikers-native-clipboard-bridge
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
